#!name=时光倒数
#!desc=Egern「时光倒数」Surge 兼容版。保留法定/民俗/国际/专属倒计时、农历节日、金融交割/行权、自定义纪念日、置顶节日、春秋假及排序逻辑；时间基准固定 UTC+8。
#!category=生活
#!system=ios
#!arguments=PINNED_HOLIDAY,PINNED_MAX_DAYS:90,PINNED_MAX_SHOW:2,QINGMING_DATE:4/4,SPRING_BREAK_DATE,AUTUMN_BREAK_DATE,SHOW_SCHOOL_HOLIDAYS:true,SHOW_FINANCE_DATES:true,ENABLE_PRIORITY_SORT:true,ENABLE_EXCLUSIVE_WEIGHT:true,ENABLE_WEEKEND_THEME:true,MAX_PER_GROUP:4,EXCLUSIVE_MAX_SHOW:6,EXCLUSIVE_NAME_1:生日,EXCLUSIVE_DATE_1:11/10,EXCLUSIVE_NAME_2,EXCLUSIVE_DATE_2,EXCLUSIVE_NAME_3,EXCLUSIVE_DATE_3,EXCLUSIVE_NAME_4,EXCLUSIVE_DATE_4,EXCLUSIVE_NAME_5,EXCLUSIVE_DATE_5,EXCLUSIVE_NAME_6,EXCLUSIVE_DATE_6,UPDATE_INTERVAL:3600
#!arguments-desc=日期使用 M/D；PINNED_HOLIDAY 多项可用竖线 | 或逗号分隔。默认保留原脚本“生日 11/10”，不需要时删除即可。

[Script]
时光倒数 = type=generic,timeout=10,engine=webview,script-path=https://raw.githubusercontent.com/Dream230-1/loon/main/Surge/Widget/Countdown_Surge.js,argument="PINNED_HOLIDAY={{{PINNED_HOLIDAY}}}&PINNED_MAX_DAYS={{{PINNED_MAX_DAYS}}}&PINNED_MAX_SHOW={{{PINNED_MAX_SHOW}}}&QINGMING_DATE={{{QINGMING_DATE}}}&SPRING_BREAK_DATE={{{SPRING_BREAK_DATE}}}&AUTUMN_BREAK_DATE={{{AUTUMN_BREAK_DATE}}}&SHOW_SCHOOL_HOLIDAYS={{{SHOW_SCHOOL_HOLIDAYS}}}&SHOW_FINANCE_DATES={{{SHOW_FINANCE_DATES}}}&ENABLE_PRIORITY_SORT={{{ENABLE_PRIORITY_SORT}}}&ENABLE_EXCLUSIVE_WEIGHT={{{ENABLE_EXCLUSIVE_WEIGHT}}}&ENABLE_WEEKEND_THEME={{{ENABLE_WEEKEND_THEME}}}&MAX_PER_GROUP={{{MAX_PER_GROUP}}}&EXCLUSIVE_MAX_SHOW={{{EXCLUSIVE_MAX_SHOW}}}&EXCLUSIVE_NAME_1={{{EXCLUSIVE_NAME_1}}}&EXCLUSIVE_DATE_1={{{EXCLUSIVE_DATE_1}}}&EXCLUSIVE_NAME_2={{{EXCLUSIVE_NAME_2}}}&EXCLUSIVE_DATE_2={{{EXCLUSIVE_DATE_2}}}&EXCLUSIVE_NAME_3={{{EXCLUSIVE_NAME_3}}}&EXCLUSIVE_DATE_3={{{EXCLUSIVE_DATE_3}}}&EXCLUSIVE_NAME_4={{{EXCLUSIVE_NAME_4}}}&EXCLUSIVE_DATE_4={{{EXCLUSIVE_DATE_4}}}&EXCLUSIVE_NAME_5={{{EXCLUSIVE_NAME_5}}}&EXCLUSIVE_DATE_5={{{EXCLUSIVE_DATE_5}}}&EXCLUSIVE_NAME_6={{{EXCLUSIVE_NAME_6}}}&EXCLUSIVE_DATE_6={{{EXCLUSIVE_DATE_6}}}"

[Panel]
时光倒数 = script-name=时光倒数,update-interval={{{UPDATE_INTERVAL}}}
